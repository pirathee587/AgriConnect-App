# ============================================================
# Frontend .gitignore — React Native / Expo (TypeScript)
# ============================================================

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependencies ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Expo ───────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ─── Native build outputs ───────────────────────────────────
/ios/
/android/
.kotlin/

# ─── Signing & certificates ─────────────────────────────────
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# ─── Metro bundler ──────────────────────────────────────────
.metro-health-check*

# ─── Debug logs ─────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*

# ─── Environment / secrets ──────────────────────────────────
.env
.env.*
!.env.example

# ─── TypeScript ─────────────────────────────────────────────
*.tsbuildinfo

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.pem

# ─── IDE ────────────────────────────────────────────────────
.idea/
.vscode/

# ─── Testing ────────────────────────────────────────────────
coverage/

# ─── Misc ───────────────────────────────────────────────────
*.local
