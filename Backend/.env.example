# Keep this file as a template only.
# Copy to .env locally and set real secrets via environment variables or secret manager.

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Disable default admin bootstrap in production
BOOTSTRAP_DEFAULT_ADMIN=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Database
DB_URL=jdbc:postgresql://localhost:5432/agriconnect
DB_USERNAME=postgres
DB_PASSWORD=

# JWT (required in non-test environments)
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRATION_MS=86400000

# CORS (comma-separated origin patterns)
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_API_URL=https://www.payhere.lk/pay/checkout

# Uploads
FILE_UPLOAD_DIR=uploads

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_DEBUG=false